BOT_TOKEN=your_telegram_bot_token_from_botfather
OPENROUTER_API_KEY=your_openrouter_api_key
TMDB_API_KEY=your_tmdb_api_key

# Необязательно — переопределяет модель по умолчанию (nvidia/nemotron-3-super-120b-a12b:free).
# Список бесплатных моделей: https://openrouter.ai/models
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Необязательно — если Telegram/TMDB/OpenRouter не доступны напрямую с сервера,
# укажи адрес локального SOCKS5-прокси, поднятого на этом же сервере.
# PROXY_URL=socks5://127.0.0.1:1080

# Необязательно — адрес n8n-вебхука, куда команда /feedback пересылает текст отзыва
# (проект ClaimsAutomation, нода Webhook, production URL после Publish).
# FEEDBACK_WEBHOOK_URL=http://localhost:5678/webhook/328e5e82-311c-46d0-8797-17249e83d36d
